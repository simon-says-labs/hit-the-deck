#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# When the deck runtime ends with an error (exit 3 = Stream Deck gone after a USB
# reset), stop the whole container instead of restarting only the service: only a
# fresh container gets the new USB device node. With the app's Watchdog switched
# on, the Supervisor then starts it again.
# Pattern: home-assistant/addons, configurator/rootfs/etc/s6-overlay/s6-rc.d/configurator/finish.
# ==============================================================================
exit_code_container=$(</run/s6-linux-init-container-results/exitcode)
exit_code_service="${1}"
exit_code_signal="${2}"

bashio::log.info "Deck runtime ended: code ${exit_code_service} (signal ${exit_code_signal})"

if [[ "${exit_code_service}" -eq 256 ]]; then
  if [[ "${exit_code_container}" -eq 0 ]]; then
    echo $((128 + exit_code_signal)) > /run/s6-linux-init-container-results/exitcode
  fi
  [[ "${exit_code_signal}" -eq 15 ]] && exec /run/s6/basedir/bin/halt
elif [[ "${exit_code_service}" -ne 0 ]]; then
  if [[ "${exit_code_container}" -eq 0 ]]; then
    echo "${exit_code_service}" > /run/s6-linux-init-container-results/exitcode
  fi
  bashio::log.warning "Stopping the container so the watchdog can start a fresh one"
  exec /run/s6/basedir/bin/halt
fi
